def export_wlan_portal_assets(api: MistApi, scope: str, scope_id: str, wlan: Dict[str, Any]) -> Dict[str, Any]:
    """
    Export portal image for a WLAN by downloading from thumbnail URL.
    The portal configuration itself is in the WLAN object (portal, portal_template_url fields).
    Images must be downloaded from the thumbnail/background URLs if present.
    """
    assets = {}
    wlan_id = wlan.get("id")
    base = f"/api/v1/{scope}/{scope_id}/wlans/{wlan_id}"
    
    # Portal config is already in the WLAN object - these fields contain the portal setup:
    # - portal: dict with all portal settings (enabled, auth, etc.)
    # - portal_template_url: URL to portal template
    # - thumbnail: URL to uploaded logo/background image
    # - portal_allowed_hostnames, portal_allowed_subnets, portal_denied_hostnames
    
    # Try to download portal image if thumbnail URL exists
    if should_copy("portal_images"):
        thumbnail_url = wlan.get("thumbnail")
        if thumbnail_url and thumbnail_url.startswith("http"):
            try:
                # Download image from the thumbnail URL
                import urllib.request
                req = urllib.request.Request(thumbnail_url)
                with urllib.request.urlopen(req, timeout=30) as r:
                    image_data = r.read()
                    if image_data:
                        import base64
                        assets["portal_image"] = base64.b64encode(image_data).decode("ascii")
                        content_type = r.headers.get("Content-Type", "image/png")
                        assets["portal_image_type"] = content_type
            except Exception as e:
                log(f"        Could not download portal image: {e}")
    
    return assets


def import_wlan_portal_assets(api: MistApi, scope: str, scope_id: str, wlan_id: str, 
                               assets: Dict[str, Any]) -> List[str]:
    """
    Import portal image for a WLAN.
    Portal configuration is part of the WLAN object and copied with it.
    This function handles the binary image upload separately.
    """
    report = []
    base = f"/api/v1/{scope}/{scope_id}/wlans/{wlan_id}"
    
    # Upload portal image if present
    if "portal_image" in assets and assets["portal_image"]:
        if not DRY_RUN:
            try:
                import base64
                image_data = base64.b64decode(assets["portal_image"])
                content_type = assets.get("portal_image_type", "image/png")
                ext = "png" if "png" in content_type else "jpg"
                api.upload_file(f"{base}/portal_image", image_data, f"portal.{ext}", content_type)
                report.append(f"portal_image: uploaded")
            except Exception as e:
                report.append(f"portal_image: upload failed - {e}")
        else:
            report.append(f"portal_image: would upload (dry-run)")
    
    return report


def export_all_wlan_portal_assets(api: MistApi, scope: str, scope_id: str, 
                                   wlans: List[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
    """Export portal assets for all WLANs that have portal enabled."""
    all_assets = {}
    
    for wlan in wlans:
        ssid = wlan_key(wlan)
        
        # Check if this WLAN has portal enabled (check various portal indicators)
        has_portal = (
            wlan.get("portal") or 
            wlan.get("portal_template_url") or 
            wlan.get("thumbnail") or
            wlan.get("auth", {}).get("type") in ["open", "psk"] and wlan.get("portal_enabled")
        )
        
        if not has_portal:
            continue
        
        log(f"      Checking portal assets for WLAN: {ssid}")
        assets = export_wlan_portal_assets(api, scope, scope_id, wlan)
        if assets:
            all_assets[ssid] = assets
    
    return all_assets


