class MistApi:
    """HTTP client for Mist API with retry logic and rate limiting."""
    
    def __init__(self, base: str, token: str, name: str = "api"):
        self.base = base.rstrip("/")
        self.token = token
        self.name = name
        self.call_count = 0
        
        # Build SSL context
        if INSECURE_SSL:
            self.ctx = ssl._create_unverified_context()
        elif CA_BUNDLE_PATH:
            self.ctx = ssl.create_default_context(cafile=CA_BUNDLE_PATH)
        else:
            self.ctx = ssl.create_default_context()
    
    def call(self, method: str, path: str, params: Optional[Dict[str, Any]] = None,
             body: Optional[Dict[str, Any]] = None, retries: int = 6) -> Any:
        """Make an API call with retry logic."""
        url = self.base + path
        if params:
            q = urllib.parse.urlencode(params, doseq=True)
            url = url + ("?" + q)
        
        data = None
        headers = {
            "Authorization": f"Token {self.token}",
            "Content-Type": "application/json",
        }
        
        if body is not None:
            data = json.dumps(body, separators=(",", ":")).encode("utf-8")
        
        for attempt in range(retries + 1):
            req = urllib.request.Request(url, data=data, method=method, headers=headers)
            try:
                self.call_count += 1
                with urllib.request.urlopen(req, context=self.ctx, timeout=60) as r:
                    b = r.read()
                    return json.loads(b.decode("utf-8") or "null") if b else None
            except urllib.error.HTTPError as e:
                code = e.getcode()
                if code in (429, 502, 503, 504) and attempt < retries:
                    wait = 1.5 * (attempt + 1)
                    if code == 429:
                        wait = 5.0 * (attempt + 1)  # Longer wait for rate limit
                    log(f"  [{self.name}] {method} {path} -> {code}, retry in {wait}s...")
                    time.sleep(wait)
                    continue
                try:
                    err_body = e.read().decode("utf-8")[:800]
                except Exception:
                    err_body = ""
                raise RuntimeError(f"{method} {path} -> {code} {err_body}")
            except urllib.error.URLError as e:
                if attempt < retries:
                    time.sleep(1.0 * (attempt + 1))
                    continue
                raise
        return None
    
    def get(self, path: str, params: Optional[Dict[str, Any]] = None) -> Any:
        return self.call("GET", path, params=params)
    
    def post(self, path: str, body: Dict[str, Any]) -> Any:
        return self.call("POST", path, body=body)
    
    def put(self, path: str, body: Dict[str, Any]) -> Any:
        return self.call("PUT", path, body=body)
    
    def delete(self, path: str) -> Any:
        return self.call("DELETE", path)
    
    def upload_file(self, path: str, file_data: bytes, filename: str, 
                    content_type: str = "image/png") -> Any:
        """Upload a file using multipart/form-data."""
        url = self.base + path
        boundary = f"----MistCloneBoundary{int(time.time()*1000)}"
        
        # Build multipart body
        body = []
        body.append(f"--{boundary}".encode())
        body.append(f'Content-Disposition: form-data; name="file"; filename="{filename}"'.encode())
        body.append(f"Content-Type: {content_type}".encode())
        body.append(b"")
        body.append(file_data)
        body.append(f"--{boundary}--".encode())
        body.append(b"")
        
        data = b"\r\n".join(body)
        
        headers = {
            "Authorization": f"Token {self.token}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
        }
        
        req = urllib.request.Request(url, data=data, method="POST", headers=headers)
        try:
            self.call_count += 1
            with urllib.request.urlopen(req, context=self.ctx, timeout=120) as r:
                b = r.read()
                return json.loads(b.decode("utf-8") or "null") if b else None
        except urllib.error.HTTPError as e:
            code = e.getcode()
            try:
                err_body = e.read().decode("utf-8")[:600]
            except Exception:
                err_body = ""
            raise RuntimeError(f"POST {path} (upload) -> {code} {err_body}")
    
    def get_binary(self, path: str) -> Optional[bytes]:
        """Download binary content (images, etc.)."""
        url = self.base + path
        headers = {
            "Authorization": f"Token {self.token}",
        }
        
        req = urllib.request.Request(url, method="GET", headers=headers)
        try:
            self.call_count += 1
            with urllib.request.urlopen(req, context=self.ctx, timeout=60) as r:
                return r.read()
        except urllib.error.HTTPError as e:
            if e.getcode() == 404:
                return None
            raise


def paged(api: MistApi, path: str, limit: int = 100) -> List[Dict[str, Any]]:
    """Fetch all pages from a paginated endpoint."""
    items = []
    page = 1
    while True:
        js = api.get(path, {"page": page, "limit": limit})
        # Handle different response formats
        if isinstance(js, dict):
            batch = js.get("results") or js.get("items") or []
        elif isinstance(js, list):
            batch = js
        else:
            break
        
        if not batch:
            break
        items.extend(batch)
        if len(batch) < limit:
            break
        page += 1
    return items


def endpoint_ok(api: MistApi, path: str) -> bool:
    """Check if an endpoint is accessible."""
    try:
        api.get(path, {"limit": 1})
        return True
    except Exception:
        return False


