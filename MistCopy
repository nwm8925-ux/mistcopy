def export_map_image(api: MistApi, site_id: str, map_id: str) -> Optional[Dict[str, Any]]:
    """Export a map's image data."""
    try:
        # Map images are at /api/v1/sites/{site_id}/maps/{map_id}/image
        image_data = api.get_binary(f"/api/v1/sites/{site_id}/maps/{map_id}/image")
        if image_data:
            import base64
            return {
                "image_data": base64.b64encode(image_data).decode("ascii"),
                "content_type": "image/png"  # Could be png, jpg, etc.
            }
    except Exception as e:
        log(f"      Map image not available: {e}")
    return None


def import_map_image(api: MistApi, site_id: str, map_id: str, 
                     image_info: Dict[str, Any]) -> List[str]:
    """Import a map's image data."""
    report = []
    
    if not image_info or "image_data" not in image_info:
        return report
    
    if not DRY_RUN:
        try:
            import base64
            image_data = base64.b64decode(image_info["image_data"])
            content_type = image_info.get("content_type", "image/png")
            ext = "png" if "png" in content_type else "jpg"
            api.upload_file(
                f"/api/v1/sites/{site_id}/maps/{map_id}/image",
                image_data, f"floorplan.{ext}", content_type
            )
            report.append(f"map_image: uploaded")
        except Exception as e:
            report.append(f"map_image: upload failed - {e}")
    else:
        report.append(f"map_image: would upload (dry-run)")
    
    return report


