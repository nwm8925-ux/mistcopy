def _import_resource(api: MistApi, base_path: str, items: List[Dict[str, Any]], 
                     resource_type: str, key_field: str, mapper: IdMapper) -> List[str]:
    """Generic resource import with upsert logic."""
    report = []
    
    if not items:
        return report
    
    log(f"  - Importing {resource_type}s...")
    
    # Get existing items
    try:
        existing = paged(api, base_path)
    except Exception as e:
        report.append(f"{resource_type}: endpoint not available - {e}")
        return report
    
    existing_by_key = by_key(existing, key_field)
    
    for item in items:
        name = item.get(key_field, "<unnamed>")
        # Remap any ID references
        item = mapper.remap_object(item)
        
        if name in existing_by_key:
            dst_item = existing_by_key[name]
            src_digest = digest(slim(item))
            dst_digest = digest(slim(dst_item))
            
            if src_digest == dst_digest:
                report.append(f"{resource_type}: {name} no change")
                # Still record the mapping
                if "id" in item:
                    mapper.add(f"{resource_type}s", item.get("_src_id", ""), dst_item["id"])
            else:
                if not DRY_RUN:
                    try:
                        api.put(f"{base_path}/{dst_item['id']}", item)
                        report.append(f"{resource_type}: {name} updated")
                    except Exception as e:
                        report.append(f"{resource_type}: {name} update failed - {e}")
                else:
                    report.append(f"{resource_type}: {name} would update (dry-run)")
                mapper.add(f"{resource_type}s", item.get("_src_id", ""), dst_item["id"])
        else:
            if not DRY_RUN:
                try:
                    result = api.post(base_path, item)
                    new_id = result.get("id") if result else None
                    report.append(f"{resource_type}: {name} created")
                    if new_id:
                        mapper.add(f"{resource_type}s", item.get("_src_id", ""), new_id)
                except Exception as e:
                    report.append(f"{resource_type}: {name} create failed - {e}")
            else:
                report.append(f"{resource_type}: {name} would create (dry-run)")
    
    return report


def _import_wlans(api: MistApi, base_path: str, items: List[Dict[str, Any]], 
                  resource_type: str, mapper: IdMapper) -> List[str]:
    """Import WLANs using SSID as key."""
    report = []
    
    if not items:
        return report
    
    log(f"  - Importing {resource_type}s...")
    
    try:
        existing = paged(api, base_path)
    except Exception as e:
        report.append(f"{resource_type}: endpoint not available - {e}")
        return report
    
    existing_by_ssid = {wlan_key(w): w for w in existing}
    
    for item in items:
        ssid = wlan_key(item)
        if not ssid:
            continue
        
        item = mapper.remap_object(item)
        
        if ssid in existing_by_ssid:
            dst_item = existing_by_ssid[ssid]
            if digest(slim(item)) == digest(slim(dst_item)):
                report.append(f"{resource_type}: {ssid} no change")
            else:
                if not DRY_RUN:
                    try:
                        api.put(f"{base_path}/{dst_item['id']}", item)
                        report.append(f"{resource_type}: {ssid} updated")
                    except Exception as e:
                        report.append(f"{resource_type}: {ssid} update failed - {e}")
                else:
                    report.append(f"{resource_type}: {ssid} would update (dry-run)")
        else:
            if not DRY_RUN:
                try:
                    api.post(base_path, item)
                    report.append(f"{resource_type}: {ssid} created")
                except Exception as e:
                    report.append(f"{resource_type}: {ssid} create failed - {e}")
            else:
                report.append(f"{resource_type}: {ssid} would create (dry-run)")
    
    return report


