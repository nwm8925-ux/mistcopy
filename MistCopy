# Main Execution
# ============================================================================

def validate_config():
    """Validate configuration before running."""
    errors = []
    
    if not API_HOST_SRC:
        errors.append("API_HOST_SRC is not set")
    if not API_HOST_DST:
        errors.append("API_HOST_DST is not set")
    if not TOKEN_SRC:
        errors.append("TOKEN_SRC is not set")
    if not TOKEN_DST:
        errors.append("TOKEN_DST is not set")
    if not SRC_ORG_ID:
        errors.append("SRC_ORG_ID is not set")
    if not DST_ORG_ID:
        errors.append("DST_ORG_ID is not set")
    
    for val in [API_HOST_SRC, API_HOST_DST, TOKEN_SRC, TOKEN_DST, SRC_ORG_ID, DST_ORG_ID]:
        if val and ("PUT_" in str(val) or "YOUR_" in str(val)):
            errors.append(f"Configuration contains placeholder value: {val[:20]}...")
    
    if errors:
        for e in errors:
            print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(2)


def main():
    """Main entry point."""
    print("=" * 70)
    print("Juniper Mist Full API Clone Tool")
    print("=" * 70)
    
    # Validate configuration
    validate_config()
    
    # Initialize API clients
    src = MistApi(API_HOST_SRC, TOKEN_SRC, "src")
    dst = MistApi(API_HOST_DST, TOKEN_DST, "dst")
    mapper = IdMapper()
    
    # Test connectivity
    log("Testing API connectivity...")
    try:
        src_self = src.get("/api/v1/self")
        log(f"  Source: {src_self.get('email', 'OK')}")
    except Exception as e:
        print(f"ERROR: Cannot connect to source API - {e}", file=sys.stderr)
        sys.exit(1)
    
    try:
        dst_self = dst.get("/api/v1/self")
        log(f"  Destination: {dst_self.get('email', 'OK')}")
    except Exception as e:
        print(f"ERROR: Cannot connect to destination API - {e}", file=sys.stderr)
        sys.exit(1)
    
    if DRY_RUN:
        print("\n*** DRY RUN MODE - No changes will be made ***\n")
    
    all_reports = []
    
    # Handle JSON import
    if IMPORT_JSON:
        log(f"Importing from JSON file: {IMPORT_JSON}")
        with open(IMPORT_JSON, "r") as f:
            full_blob = json.load(f)
        
        if "org" in full_blob:
            reports = import_org(dst, DST_ORG_ID, full_blob["org"], mapper)
            all_reports.extend(reports)
        
        if "sites" in full_blob:
            for site_name, site_blob in full_blob["sites"].items():
                log(f"\nProcessing site: {site_name}")
                dst_site_id = get_or_create_site(dst, DST_ORG_ID, site_name)
                if dst_site_id:
                    reports = import_site(dst, dst_site_id, site_blob, mapper)
                    all_reports.extend(reports)
    
    else:
        # Export and import organization level
        if COPY_MODE in ("full", "org-only", "selective"):
            org_blob = export_org(src, SRC_ORG_ID)
            
            if EXPORT_JSON:
                full_export = {"org": org_blob, "sites": {}}
            else:
                reports = import_org(dst, DST_ORG_ID, org_blob, mapper)
                all_reports.extend(reports)
        
        # Process sites
        if COPY_MODE in ("full", "sites-only", "selective"):
            # Single site copy mode
            if SRC_SITE_ID and DST_SITE_ID:
                log(f"\nCopying single site: {SRC_SITE_ID} -> {DST_SITE_ID}")
                site_blob = export_site(src, SRC_SITE_ID)
                
                if EXPORT_JSON:
                    full_export["sites"]["single_site"] = site_blob
                else:
                    reports = import_site(dst, DST_SITE_ID, site_blob, mapper)
                    all_reports.extend(reports)
            
            else:
                # Multiple sites by name
                src_sites = list_sites(src, SRC_ORG_ID)
                
                if LIMIT_SITE_NAMES:
                    wanted = set(n.strip() for n in LIMIT_SITE_NAMES if n.strip())
                    src_sites = [s for s in src_sites if s.get("name") in wanted]
                    if not src_sites:
                        log("No matching sites found for LIMIT_SITE_NAMES")
                
                dst_sites = by_key(list_sites(dst, DST_ORG_ID), "name")
                
                for src_site in src_sites:
                    name = src_site.get("name", "")
                    if not name:
                        log(f"Skipping unnamed site: {src_site.get('id')}")
                        continue
                    
                    log(f"\nProcessing site: {name}")
                    site_blob = export_site(src, src_site["id"])
                    
                    if EXPORT_JSON:
                        full_export["sites"][name] = site_blob
                    else:
                        dst_site_id = dst_sites.get(name, {}).get("id")
                        if not dst_site_id:
                            dst_site_id = get_or_create_site(dst, DST_ORG_ID, name, src_site)
                            mapper.add("sites", src_site["id"], dst_site_id)
                        
                        if dst_site_id:
                            reports = import_site(dst, dst_site_id, site_blob, mapper)
                            all_reports.extend(reports)
        
        # Write JSON export
        if EXPORT_JSON:
            export_file = f"mist_export_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
            with open(export_file, "w") as f:
                json.dump(full_export, f, indent=2)
            log(f"\nExported to: {export_file}")
    
    # Interactive inventory migration (after all sites are created so we have site mappings)
    if should_copy("inventory") and INTERACTIVE_MODE and not EXPORT_JSON:
        log("\n" + "=" * 70)
        log("DEVICE INVENTORY MIGRATION")
        log("=" * 70)
        
        # Export inventory from source
        inventory = export_inventory(src, SRC_ORG_ID)
        
        if inventory:
            reports = interactive_inventory_migration(
                src, dst, SRC_ORG_ID, DST_ORG_ID, 
                inventory, mapper
            )
            all_reports.extend(reports)
    
    # Summary
    print("\n" + "=" * 70)
    print("SUMMARY")
    print("=" * 70)
    
    if all_reports:
        created = sum(1 for r in all_reports if "created" in r)
        updated = sum(1 for r in all_reports if "updated" in r)
        unchanged = sum(1 for r in all_reports if "no change" in r)
        failed = sum(1 for r in all_reports if "failed" in r)
        
        print(f"Created: {created}")
        print(f"Updated: {updated}")
        print(f"Unchanged: {unchanged}")
        print(f"Failed: {failed}")
        
        if failed > 0:
            print("\nFailed operations:")
            for r in all_reports:
                if "failed" in r:
                    print(f"  - {r}")
    
    print(f"\nAPI calls: src={src.call_count}, dst={dst.call_count}")
    print("=" * 70)


if __name__ == "__main__":
    main()

