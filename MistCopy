    # Portal assets for site WLANs
    if "site_wlan_portal_assets" in blob and blob["site_wlan_portal_assets"]:
        log("    - Importing portal assets for site WLANs")
        # Get current WLANs to find IDs by SSID
        current_wlans = paged(api, f"/api/v1/sites/{site_id}/wlans")
        wlan_id_by_ssid = {wlan_key(w): w.get("id") for w in current_wlans}
        
        for ssid, assets in blob["site_wlan_portal_assets"].items():
