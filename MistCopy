}


def log(msg: str):
    """Print log message if verbose mode is enabled."""
    if VERBOSE:
        print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}")


def slim(obj: Dict[str, Any], extra_drop: Set[str] = None) -> Dict[str, Any]:
    """Remove system fields from an object for comparison/copying."""
    drop = DROP_FIELDS | (extra_drop or set())
    return {k: v for k, v in obj.items() if k not in drop}


def digest(obj: Any) -> str:
    """Generate a hash digest of an object for comparison."""
    return hashlib.sha256(
        json.dumps(obj, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def by_key(lst: List[Dict[str, Any]], key: str = "name") -> Dict[str, Dict[str, Any]]:
    """Index a list of objects by a key field."""
    d = {}
    for item in lst:
        k = item.get(key)
        if k:
            d[k] = item
    return d


def wlan_key(w: Dict[str, Any]) -> str:
    """Get unique key for a WLAN (SSID or name)."""
    return w.get("ssid") or w.get("name") or ""


def safe_get(api: MistApi, path: str, default: Any = None) -> Any:
    """Safely get from an endpoint, returning default on error."""
    try:
        return api.get(path)
    except Exception as e:
        log(f"  Warning: {path} -> {e}")
        return default


def safe_paged(api: MistApi, path: str) -> List[Dict[str, Any]]:
    """Safely get paginated results, returning empty list on error."""
    try:
        return paged(api, path)
    except Exception as e:
        log(f"  Warning: {path} -> {e}")
        return []


