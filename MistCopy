class IdMapper:
    """Track ID mappings between source and destination for reference resolution."""
    
    def __init__(self):
        self.maps: Dict[str, Dict[str, str]] = {
            "sites": {},
            "rftemplates": {},
            "networktemplates": {},
            "aptemplates": {},
            "gatewaytemplates": {},
            "templates": {},
            "sitegroups": {},
            "deviceprofiles": {},
            "deviceprofiles_gateway": {},
            "alarmtemplates": {},
            "mxclusters": {},
            "mxedges": {},
            "wxtunnels": {},
            "wxtags": {},
            "maps": {},
            "zones": {},
            "networks": {},
            "services": {},
        }
    
    def add(self, resource_type: str, src_id: str, dst_id: str):
        """Add a mapping from source ID to destination ID."""
        if resource_type in self.maps and src_id and dst_id:
            self.maps[resource_type][src_id] = dst_id
    
    def get(self, resource_type: str, src_id: str) -> Optional[str]:
        """Get destination ID for a source ID."""
        return self.maps.get(resource_type, {}).get(src_id)
    
    def remap_object(self, obj: Dict[str, Any]) -> Dict[str, Any]:
        """Remap ID references in an object to destination IDs."""
        result = obj.copy()
        
        # Single ID fields
        field_mapping = {
            "rftemplate_id": "rftemplates",
            "networktemplate_id": "networktemplates",
            "aptemplate_id": "aptemplates",
            "gatewaytemplate_id": "gatewaytemplates",
            "template_id": "templates",
            "deviceprofile_id": "deviceprofiles",
            "alarmtemplate_id": "alarmtemplates",
            "mxcluster_id": "mxclusters",
            "mxedge_id": "mxedges",
            "wxtunnel_id": "wxtunnels",
            "map_id": "maps",
            "zone_id": "zones",
        }
        
        for field, resource_type in field_mapping.items():
            if field in result and result[field]:
                new_id = self.get(resource_type, result[field])
                if new_id:
                    result[field] = new_id
        
        # List ID fields
        list_field_mapping = {
            "sitegroup_ids": "sitegroups",
            "wxtag_ids": "wxtags",
            "apply_tags": "wxtags",
            "except_tags": "wxtags",
        }
        
        for field, resource_type in list_field_mapping.items():
            if field in result and result[field]:
                result[field] = [
                    self.get(resource_type, id_) or id_
                    for id_ in result[field]
                ]
        
        return result


