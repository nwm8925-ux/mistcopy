def import_org(api: MistApi, org_id: str, blob: Dict[str, Any], mapper: IdMapper) -> List[str]:
    """Import organization-level configuration."""
    log("Importing organization configuration...")
    report = []
    
    # Process in dependency order
    
    # 1. Site Groups (needed for site assignment)
    if "sitegroups" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/orgs/{org_id}/sitegroups",
            blob["sitegroups"], "sitegroup", "name", mapper
        ))
    
    # 2. Networks (needed by templates and policies)
    if "networks" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/orgs/{org_id}/networks",
            blob["networks"], "network", "name", mapper
        ))
    
    # 3. Services
    if "services" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/orgs/{org_id}/services",
            blob["services"], "service", "name", mapper
        ))
    
    # 4. WxLAN Tags (needed by WxLAN rules)
    if "wxtags" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/orgs/{org_id}/wxtags",
