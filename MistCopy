def export_inventory(api: MistApi, org_id: str) -> Dict[str, Any]:
    """
    Export inventory with device details and claim codes.
    The 'magic' field contains the claim code needed for re-claiming.
    """
    inventory = {}
    
    try:
        # Get full inventory - includes 'magic' (claim code) for each device
        devices = paged(api, f"/api/v1/orgs/{org_id}/inventory")
        
        # Organize by type
        inventory["aps"] = []
        inventory["switches"] = []
        inventory["gateways"] = []
        inventory["mxedges"] = []
        
        for device in devices:
            device_type = device.get("type", "ap")
            entry = {
                "mac": device.get("mac"),
                "serial": device.get("serial"),
                "model": device.get("model"),
                "name": device.get("name"),
                "site_id": device.get("site_id"),
                "site_name": device.get("site_name"),
                "magic": device.get("magic"),  # Claim code!
                "deviceprofile_id": device.get("deviceprofile_id"),
                # AP placement info
                "map_id": device.get("map_id"),
                "x": device.get("x"),
                "y": device.get("y"),
                "height": device.get("height"),
                "orientation": device.get("orientation"),
                "notes": device.get("notes"),
            }
            
            if device_type == "ap":
                inventory["aps"].append(entry)
            elif device_type == "switch":
                inventory["switches"].append(entry)
            elif device_type == "gateway":
                inventory["gateways"].append(entry)
            elif device_type == "mxedge":
                inventory["mxedges"].append(entry)
        
        log(f"  Inventory: {len(inventory['aps'])} APs, {len(inventory['switches'])} switches, "
            f"{len(inventory['gateways'])} gateways")
        
    except Exception as e:
        log(f"  Warning: Could not export inventory - {e}")
    
    return inventory


def release_devices_from_org(api: MistApi, org_id: str, macs: List[str]) -> Tuple[bool, str]:
    """
    Release (unclaim) devices from an organization.
    Devices must be released before they can be claimed to another org.
    
    Returns:
        Tuple of (success, message)
    """
    if not macs:
        return True, "No devices to release"
    
    try:
        # Release uses PUT with op="delete"
        result = api.put(f"/api/v1/orgs/{org_id}/inventory", {
            "op": "delete",
            "macs": macs
        })
        return True, f"Released {len(macs)} devices"
    except Exception as e:
        return False, f"Release failed: {e}"


def claim_devices_to_org(api: MistApi, org_id: str, claim_codes: List[str]) -> Tuple[bool, str, Dict]:
    """
    Claim devices to an organization using claim codes.
    
    Returns:
        Tuple of (success, message, result_dict)
    """
    if not claim_codes:
        return True, "No devices to claim", {}
    
    try:
        result = api.post(f"/api/v1/orgs/{org_id}/inventory", claim_codes)
        
        added = result.get("added", []) if result else []
        duplicated = result.get("duplicated", [])
        errors = result.get("error", [])
        reasons = result.get("reason", [])
        
        if errors:
            error_details = ", ".join(f"{e}: {r}" for e, r in zip(errors, reasons))
            return False, f"Claim errors: {error_details}", result
        
        return True, f"Claimed {len(added)} devices ({len(duplicated)} already present)", result
        
    except Exception as e:
        return False, f"Claim failed: {e}", {}


def interactive_inventory_migration(src_api: MistApi, dst_api: MistApi, 
                                     src_org_id: str, dst_org_id: str,
                                     inventory: Dict[str, Any], 
                                     mapper: IdMapper) -> List[str]:
    """
    Interactive inventory migration with user prompts.
    
    Flow:
    1. Show devices and their claim codes
    2. Ask user which devices to migrate (or use DEVICE_MACS_TO_MIGRATE)
    3. Optionally allow user to enter claim codes manually
    4. Release from source org (with confirmation)
    5. Claim to destination org
    6. Assign to sites and place on maps
    """
    report = []
    
    # Combine all device types
    all_devices = (
        inventory.get("aps", []) + 
        inventory.get("switches", []) + 
        inventory.get("gateways", [])
    )
    
    if not all_devices:
        log("  No devices in inventory to migrate")
        return report
    
    # Filter devices if DEVICE_MACS_TO_MIGRATE is specified
    if DEVICE_MACS_TO_MIGRATE.strip():
        wanted_macs = set(m.strip().lower().replace(":", "").replace("-", "") 
                         for m in DEVICE_MACS_TO_MIGRATE.split(",") if m.strip())
        all_devices = [d for d in all_devices 
                       if d.get("mac", "").lower().replace(":", "") in wanted_macs]
        log(f"  Filtered to {len(all_devices)} devices based on DEVICE_MACS_TO_MIGRATE")
    
    if not all_devices:
        log("  No matching devices found")
        return report
    
    # Build working claim codes dict (start with config, add from inventory)
    working_claim_codes = dict(DEVICE_CLAIM_CODES)
    for device in all_devices:
        mac = device.get("mac", "")
        if mac and device.get("magic") and mac not in working_claim_codes:
            working_claim_codes[mac] = device.get("magic")
    
    # Display devices and claim codes
    print("\n" + "=" * 70)
    print("DEVICE INVENTORY - CLAIM CODES")
    print("=" * 70)
    print(f"{'#':<4} {'MAC Address':<18} {'Model':<15} {'Name':<20} {'Claim Code':<20}")
    print("-" * 70)
    
    devices_missing_codes = []
    for i, device in enumerate(all_devices, 1):
        mac = device.get("mac", "")
        model = device.get("model", "")[:15]
        name = (device.get("name") or "")[:20]
        magic = working_claim_codes.get(mac, "")
        
        status = "" if magic else " <-- MISSING"
        print(f"{i:<4} {mac:<18} {model:<15} {name:<20} {magic:<20}{status}")
        
        if not magic:
            devices_missing_codes.append(mac)
    
    print("-" * 70)
    print(f"Total: {len(all_devices)} devices")
    if devices_missing_codes:
        print(f"Missing claim codes: {len(devices_missing_codes)}")
    print("=" * 70)
    
    # If any devices are missing claim codes, offer to enter them
    if devices_missing_codes and not DRY_RUN:
        print("\nSome devices are missing claim codes.")
        print("You can find claim codes on the physical device label or in Mist Portal")
        print("  (Organization > Inventory > click device > 'Claim Code' field)")
        print("")
        response = input("Enter claim codes now? (yes/no/skip): ").strip().lower()
        
        if response in ("yes", "y"):
            print("\nEnter claim codes (comma-separated) in format: MAC=CODE,MAC=CODE")
            print("Example: 5c5b35ae890d=MAEGXREBCNJ2V9Z,5c5b35ae890e=ABCDEFGHIJKLMNO")
            print("Or just enter codes in order matching device list above.")
            print("")
            
            codes_input = input("Claim codes: ").strip()
            
            if codes_input:
                # Parse input - either MAC=CODE format or just codes in order
                if "=" in codes_input:
                    # MAC=CODE format
                    for pair in codes_input.split(","):
                        pair = pair.strip()
                        if "=" in pair:
                            mac, code = pair.split("=", 1)
                            mac = mac.strip().lower().replace(":", "").replace("-", "")
                            code = code.strip().upper()
                            if mac and code:
                                # Find device with this MAC
                                for d in all_devices:
                                    if d.get("mac", "").lower().replace(":", "") == mac:
                                        working_claim_codes[d.get("mac")] = code
                                        break
                else:
                    # Just codes in order - apply to missing devices
                    codes = [c.strip().upper() for c in codes_input.split(",") if c.strip()]
                    for mac, code in zip(devices_missing_codes, codes):
                        working_claim_codes[mac] = code
            
            # Refresh display
            print("\nUpdated claim codes:")
            print("-" * 70)
            for device in all_devices:
                mac = device.get("mac", "")
                code = working_claim_codes.get(mac, "MISSING")
                print(f"  {mac}: {code}")
            print("-" * 70)
        
        elif response == "skip":
            # Only process devices that have codes
            all_devices = [d for d in all_devices if working_claim_codes.get(d.get("mac"))]
            print(f"Proceeding with {len(all_devices)} devices that have claim codes")
    
    # Build final list of devices with codes
    devices_with_codes = []
    for device in all_devices:
        mac = device.get("mac", "")
        code = working_claim_codes.get(mac)
        if code:
            devices_with_codes.append({**device, "magic": code})
        else:
            report.append(f"inventory: {mac} has no claim code - skipped")
    
    if not devices_with_codes:
        log("  No devices have claim codes available")
        return report
    
    # Check if devices are already in destination
    try:
        dst_inventory = paged(dst_api, f"/api/v1/orgs/{dst_org_id}/inventory")
        dst_macs = {d.get("mac") for d in dst_inventory}
    except Exception:
        dst_macs = set()
    
    devices_to_migrate = [d for d in devices_with_codes if d.get("mac") not in dst_macs]
    already_in_dst = [d for d in devices_with_codes if d.get("mac") in dst_macs]
    
    if already_in_dst:
        print(f"\n{len(already_in_dst)} devices already in destination org")
        for d in already_in_dst:
            report.append(f"inventory: {d.get('mac')} already in destination")
    
    if not devices_to_migrate:
        log("  All devices already in destination org")
        return report
    
    print(f"\n{len(devices_to_migrate)} devices need to be migrated")
    
    # Track if we should auto-release
    do_auto_release = AUTO_RELEASE_FROM_SOURCE
    
    # Interactive confirmation
    if INTERACTIVE_MODE and not DRY_RUN:
        print("\n*** IMPORTANT ***")
        print("Devices must be RELEASED from the source org before claiming to destination.")
        print("This will temporarily disconnect the devices from cloud management.")
        print("")
        
        print("Options:")
        print("  1. I will manually release devices from source org (via Mist portal)")
        print("  2. Auto-release devices from source org now (script will do it)")
        print("  3. Skip device migration")
        response = input("Choose option (1/2/3): ").strip()
        
        if response == "1":
            print("\n" + "=" * 70)
            print("MANUAL RELEASE INSTRUCTIONS")
            print("=" * 70)
            print("\nRelease these devices from the SOURCE org:")
            print("")
            for d in devices_to_migrate:
                print(f"  MAC: {d.get('mac'):<18}  Name: {d.get('name', 'unnamed')}")
            print("")
            print("Steps in Mist Portal:")
            print("  1. Go to: Organization > Inventory")
            print("  2. Select the devices listed above")
            print("  3. Click 'More' > 'Release from Org'")
            print("  4. Confirm the release")
            print("")
            print("=" * 70)
            input("\nPress ENTER when devices have been released from source org...")
            do_auto_release = False
            
        elif response == "2":
            print("\nWill auto-release devices from source org...")
            do_auto_release = True
            
        else:
            log("  Device migration skipped by user")
            return report
    
    # Release from source if auto-release enabled
    macs_to_release = [d.get("mac") for d in devices_to_migrate]
    
    if do_auto_release and not DRY_RUN:
        print("\nReleasing devices from source org...")
        success, msg = release_devices_from_org(src_api, src_org_id, macs_to_release)
        report.append(f"inventory release: {msg}")
        
        if not success:
            log(f"  Release failed: {msg}")
            return report
        
        # Wait for cloud to process
        print("Waiting for release to propagate (5 seconds)...")
        time.sleep(5)
    
    # Claim to destination
    claim_codes = [d.get("magic") for d in devices_to_migrate if d.get("magic")]
    
    if DRY_RUN:
        report.append(f"inventory: would claim {len(claim_codes)} devices (dry-run)")
    else:
        print("\nClaiming devices to destination org...")
        success, msg, result = claim_devices_to_org(dst_api, dst_org_id, claim_codes)
        report.append(f"inventory claim: {msg}")
        
        if not success:
            # Check if devices still belong to source
            errors = result.get("error", [])
            reasons = result.get("reason", [])
            if any("belongs to another org" in r for r in reasons):
                print("\n" + "!" * 70)
                print("ERROR: Devices still belong to source org!")
                print("!" * 70)
                print("\nThe devices were not released properly. Please release them manually:")
                print("")
                for d in devices_to_migrate:
                    print(f"  MAC: {d.get('mac')}")
                print("")
                print("Steps: Mist Portal > Organization > Inventory > Select devices > More > Release")
                print("")
                retry = input("Retry claiming after you release them? (yes/no): ").strip().lower()
                if retry in ("yes", "y"):
                    print("\nRetrying claim...")
                    success, msg, result = claim_devices_to_org(dst_api, dst_org_id, claim_codes)
                    report.append(f"inventory claim retry: {msg}")
                    if not success:
                        return report
                else:
                    return report
            else:
                return report
    
    # Assign to sites and place on maps
    if not DRY_RUN:
        print("\nAssigning devices to sites...")
        for device in devices_to_migrate:
            mac = device.get("mac")
            src_site_id = device.get("site_id")
            
            if not src_site_id:
                continue
            
            # Get destination site ID
            dst_site_id = mapper.get("sites", src_site_id)
            if not dst_site_id:
                report.append(f"inventory: {mac} - destination site not found")
                continue
            
            try:
                # Assign to site
                dst_api.put(f"/api/v1/orgs/{dst_org_id}/inventory", {
                    "op": "assign",
                    "site_id": dst_site_id,
                    "macs": [mac]
                })
                report.append(f"inventory: {mac} assigned to site")
                
                # Place on map if coordinates exist
                if device.get("map_id") and device.get("x") is not None:
                    dst_map_id = mapper.get("maps", device.get("map_id"))
                    if dst_map_id:
                        # Get device ID
                        time.sleep(0.5)  # Brief delay for assignment to propagate
                        dev_list = dst_api.get(f"/api/v1/sites/{dst_site_id}/devices", 
                                               {"mac": mac})
                        if dev_list and isinstance(dev_list, list) and len(dev_list) > 0:
                            dev_id = dev_list[0].get("id")
                            if dev_id:
                                dst_api.put(f"/api/v1/sites/{dst_site_id}/devices/{dev_id}", {
                                    "map_id": dst_map_id,
                                    "x": device.get("x"),
                                    "y": device.get("y"),
                                    "height": device.get("height"),
                                    "orientation": device.get("orientation"),
                                    "name": device.get("name"),
                                })
                                report.append(f"inventory: {mac} placed on map")
            except Exception as e:
                report.append(f"inventory: {mac} assignment error - {e}")
    
    return report


def import_inventory(api: MistApi, org_id: str, inventory: Dict[str, Any], 
                     mapper: IdMapper, claim_codes: Dict[str, str] = None) -> List[str]:
    """
    Import inventory - simplified version for non-interactive mode.
    For full interactive migration, use interactive_inventory_migration().
    """
    report = []
    
    if not inventory:
        return report
    
    # Combine all device types
    all_devices = (
        inventory.get("aps", []) + 
        inventory.get("switches", []) + 
        inventory.get("gateways", [])
    )
    
    if not all_devices:
        return report
    
    log("  - Processing inventory...")
    
    # Get current inventory to see what's already claimed
    try:
        current = paged(api, f"/api/v1/orgs/{org_id}/inventory")
        current_macs = {d.get("mac") for d in current}
    except Exception:
        current_macs = set()
    
    # Collect claim codes for devices not already in destination
    codes_to_claim = []
    for device in all_devices:
        mac = device.get("mac")
        if not mac:
            continue
        
        if mac in current_macs:
            report.append(f"inventory: {mac} already claimed")
            continue
        
        # Get claim code from provided codes or from exported 'magic'
        code = None
        if claim_codes:
            code = claim_codes.get(mac)
        if not code:
            code = device.get("magic")
        
        if code:
            codes_to_claim.append(code)
        else:
            report.append(f"inventory: {mac} no claim code available")
    
    # Claim devices
    if codes_to_claim:
        if not DRY_RUN:
            success, msg, result = claim_devices_to_org(api, org_id, codes_to_claim)
            report.append(f"inventory: {msg}")
            
            if not success and result.get("reason"):
                reasons = result.get("reason", [])
                if any("belongs to another org" in r for r in reasons):
                    report.append("inventory: NOTE - devices must be released from source org first")
                    report.append("inventory: Run with INTERACTIVE_MODE=True for guided migration")
        else:
            report.append(f"inventory: would claim {len(codes_to_claim)} devices (dry-run)")
    
    return report


