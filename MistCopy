def list_sites(api: MistApi, org_id: str) -> List[Dict[str, Any]]:
    """Get all sites in an organization."""
    return paged(api, f"/api/v1/orgs/{org_id}/sites")


def get_or_create_site(api: MistApi, org_id: str, name: str, src_site: Dict[str, Any] = None) -> str:
    """Get existing site by name or create new one."""
    sites = list_sites(api, org_id)
    for s in sites:
        if s.get("name") == name:
            return s["id"]
    
    # Create new site with basic properties from source
    new_site = {"name": name}
    if src_site:
        for field in ["timezone", "country_code", "address", "latlng"]:
            if field in src_site:
                new_site[field] = src_site[field]
    
    if not DRY_RUN:
        created = api.post(f"/api/v1/orgs/{org_id}/sites", new_site)
        return created["id"]
    else:
        log(f"  Would create site: {name} (dry-run)")
        return ""


def should_copy(resource: str) -> bool:
    """Check if a resource type should be copied based on mode and settings."""
    if COPY_MODE == "full":
        return True
    elif COPY_MODE == "org-only":
        return not resource.startswith("site_") and resource not in [
            "maps", "zones", "rssizones", "vbeacons", "beacons", "mxtunnels", 
            "haclusters", "vcs"
        ]
    elif COPY_MODE == "sites-only":
        return resource.startswith("site_") or resource in [
            "maps", "zones", "rssizones", "vbeacons", "beacons", "mxtunnels",
            "haclusters", "vcs", "site_settings"
        ]
    elif COPY_MODE == "selective":
        return COPY_RESOURCES.get(resource, False)
    return False


