def import_site(api: MistApi, site_id: str, blob: Dict[str, Any], mapper: IdMapper) -> List[str]:
    """Import site-level configuration."""
    report = []
    
    # Site settings
    if "settings" in blob:
        log("    - Site settings")
        try:
            cur = slim(api.get(f"/api/v1/sites/{site_id}/setting"))
            if digest(cur) != digest(blob["settings"]):
                if not DRY_RUN:
                    api.put(f"/api/v1/sites/{site_id}/setting", mapper.remap_object(blob["settings"]))
                    report.append("site.settings: updated")
                else:
                    report.append("site.settings: would update (dry-run)")
            else:
                report.append("site.settings: no change")
        except Exception as e:
            report.append(f"site.settings: failed - {e}")
    
    # Maps - need to track ID mappings for zones
    if "maps" in blob:
        log("    - Maps")
        try:
            existing_maps = paged(api, f"/api/v1/sites/{site_id}/maps")
            existing_by_name = by_key(existing_maps, "name")
            
            for item in blob["maps"]:
                name = item.get("name", "<unnamed>")
                src_id = item.get("_src_id")  # Track source ID for zone remapping
                item_clean = {k: v for k, v in item.items() if k != "_src_id"}
                
                if name in existing_by_name:
                    dst_item = existing_by_name[name]
                    # Record mapping for zones
                    if src_id:
                        mapper.add("maps", src_id, dst_item["id"])
                    
                    if digest(slim(item_clean)) == digest(slim(dst_item)):
                        report.append(f"map: {name} no change")
                    else:
                        if not DRY_RUN:
                            try:
                                api.put(f"/api/v1/sites/{site_id}/maps/{dst_item['id']}", item_clean)
                                report.append(f"map: {name} updated")
                            except Exception as e:
                                report.append(f"map: {name} update failed - {e}")
                        else:
                            report.append(f"map: {name} would update (dry-run)")
                else:
                    if not DRY_RUN:
                        try:
                            result = api.post(f"/api/v1/sites/{site_id}/maps", item_clean)
                            new_id = result.get("id") if result else None
                            report.append(f"map: {name} created")
                            if new_id and src_id:
                                mapper.add("maps", src_id, new_id)
                        except Exception as e:
                            report.append(f"map: {name} create failed - {e}")
                    else:
                        report.append(f"map: {name} would create (dry-run)")
        except Exception as e:
            report.append(f"maps: endpoint not available - {e}")
        
        # Import map images if present
        if "map_images" in blob and blob["map_images"]:
            log("    - Map images")
            # Get current maps to find IDs by name
            current_maps = paged(api, f"/api/v1/sites/{site_id}/maps")
            map_id_by_name = {m.get("name"): m.get("id") for m in current_maps}
            
            for map_name, image_info in blob["map_images"].items():
                map_id = map_id_by_name.get(map_name)
                if map_id:
                    image_reports = import_map_image(api, site_id, map_id, image_info)
                    for ir in image_reports:
                        report.append(f"map.{map_name}.{ir}")
                else:
                    report.append(f"map.{map_name}.image: map not found, skipping image")
    
    # Zones (need maps first for map_id remapping)
    if "zones" in blob:
        log("    - Zones")
        # Zones require a valid map_id - need to remap from source to destination
        # First get the current maps to build the ID mapping
        if "maps" in blob:
            current_maps = paged(api, f"/api/v1/sites/{site_id}/maps")
            map_name_to_id = {m.get("name"): m.get("id") for m in current_maps}
            
            # Also build reverse lookup from source maps
            src_map_id_to_name = {}
            for m in blob.get("maps", []):
                if "_src_id" in m:
                    src_map_id_to_name[m["_src_id"]] = m.get("name")
        
        zones_to_import = []
        for zone in blob["zones"]:
            zone = mapper.remap_object(zone)
            
            # Remap map_id specifically
            src_map_id = zone.get("map_id")
            if src_map_id:
                # Try to find destination map_id
                dst_map_id = mapper.get("maps", src_map_id)
                if dst_map_id:
                    zone["map_id"] = dst_map_id
                    zones_to_import.append(zone)
                else:
                    # Try to find by name if we have the mapping
                    map_name = src_map_id_to_name.get(src_map_id) if "maps" in blob else None
                    if map_name and map_name in map_name_to_id:
                        zone["map_id"] = map_name_to_id[map_name]
                        zones_to_import.append(zone)
                    else:
                        report.append(f"zone: {zone.get('name', '<unnamed>')} skipped - map_id not found")
            else:
                report.append(f"zone: {zone.get('name', '<unnamed>')} skipped - no map_id")
        
        if zones_to_import:
            report.extend(_import_resource(
                api, f"/api/v1/sites/{site_id}/zones",
                zones_to_import, "zone", "name", mapper
            ))
    
    # RSSI Zones
    if "rssizones" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/sites/{site_id}/rssizones",
            blob["rssizones"], "rssizone", "name", mapper
        ))
    
    # Virtual Beacons
    if "vbeacons" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/sites/{site_id}/vbeacons",
            blob["vbeacons"], "vbeacon", "name", mapper
        ))
    
    # Beacons
    if "beacons" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/sites/{site_id}/beacons",
            blob["beacons"], "beacon", "name", mapper
        ))
    
    # Networks
    if "networks" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/sites/{site_id}/networks",
            blob["networks"], "site_network", "name", mapper
        ))
    
    # Services
    if "services" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/sites/{site_id}/services",
            blob["services"], "site_service", "name", mapper
        ))
    
    # WxLAN Tags
    if "wxtags" in blob:
        report.extend(_import_resource(
            api, f"/api/v1/sites/{site_id}/wxtags",
            blob["wxtags"], "site_wxtag", "name", mapper
        ))
    
    # WxLAN Tunnels
    if "wxtunnels" in blob:
        report.extend(_import_resource(
